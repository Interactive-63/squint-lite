<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SquintLite.ViewModels"
        xmlns:s="using:SquintLite.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="360"
        d:DesignHeight="540"
        x:Class="SquintLite.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SquintLite"
        Width="360"
        Height="540"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Margin="12">

        <!-- Colour swatches: clicking opens the picker flyout for each channel -->
        <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,8">

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Foreground" FontSize="11" Opacity="0.65"/>
                <Button HorizontalAlignment="Stretch" Padding="0">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="8">
                                <ColorView Color="{Binding ForegroundColor, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              IsColorPaletteVisible="False"
                                              IsColorPreviewVisible="False"
                                              IsAccentColorsVisible="False"

                                              />
                                <Button Content="Pick from screen"
                                        Command="{Binding RequestForegroundEyedropperCommand}"
                                        IsVisible="{x:Static s:EyedropperService.IsSupported}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <!-- Layered swatch: background fill beneath alpha-aware foreground -->
                    <Panel Height="44">
                        <Border CornerRadius="4" Background="{Binding BackgroundBrush}"/>
                        <Border CornerRadius="4" Background="{Binding ForegroundBrush}"/>
                    </Panel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Background" FontSize="11" Opacity="0.65"/>
                <Button HorizontalAlignment="Stretch" Padding="0">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Spacing="8">
                                <ColorView Color="{Binding BackgroundColor, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch"
                                              IsAlphaVisible="False"
                                              IsColorPaletteVisible="False"
                                              IsColorPreviewVisible="False"
                                              IsAccentColorsVisible="False"/>
                                <Button Content="Pick from screen"
                                        Command="{Binding RequestBackgroundEyedropperCommand}"
                                        IsVisible="{x:Static s:EyedropperService.IsSupported}"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Center"/>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <Border Height="44" CornerRadius="4" Background="{Binding BackgroundBrush}"/>
                </Button>
            </StackPanel>

        </Grid>

        <!-- Hex inputs -->
        <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,10">
            <TextBox Grid.Column="0"
                     Text="{Binding ForegroundHex}"
                     FontSize="12"
                     HorizontalContentAlignment="Center"
                     MaxLength="7"/>
            <TextBox Grid.Column="2"
                     Text="{Binding BackgroundHex}"
                     FontSize="12"
                     HorizontalContentAlignment="Center"
                     MaxLength="7"/>
        </Grid>

        <!-- Contrast ratio display -->
        <Border CornerRadius="4"
                Padding="20,10"
                HorizontalAlignment="Center"
                Margin="0,0,0,10"
                BorderThickness="2"
                BorderBrush="#30808080">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
                <TextBlock Text="Contrast Ratio"
                           FontSize="11"
                           Opacity="0.65"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ContrastRatioDisplay}"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Section separator -->
        <Border Height="1" Background="#20808080" Margin="0,0,0,8"/>

        <!-- Normal Text: AA requires 4.5:1, AAA requires 7.0:1 -->
        <Grid ColumnDefinitions="130,8,*" MinHeight="58" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="Normal Text" FontWeight="SemiBold" FontSize="12"/>
                <Grid ColumnDefinitions="Auto,8,Auto" RowDefinitions="Auto,5,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="WCAG AA:" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding NormalTextAAResult}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WCAG AAA:" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding NormalTextAAAResult}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="4" Padding="8" Background="{Binding BackgroundBrush}">
                <TextBlock Text="The five boxing wizards jump quickly."
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{Binding ForegroundBrush}"/>
            </Border>
        </Grid>

        <!-- Section separator -->
        <Border Height="1" Background="#20808080" Margin="0,0,0,8"/>

        <!-- Large Text: AA requires 3.0:1, AAA requires 4.5:1 -->
        <!-- 24px = 18pt at 96 DPI, satisfying the WCAG large text threshold at any weight -->
        <Grid ColumnDefinitions="130,8,*" MinHeight="58" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="Large Text" FontWeight="SemiBold" FontSize="12"/>
                <Grid ColumnDefinitions="Auto,8,Auto" RowDefinitions="Auto,5,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="WCAG AA:" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LargeTextAAResult}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WCAG AAA:" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding LargeTextAAAResult}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="4" Padding="8" Background="{Binding BackgroundBrush}">
                <TextBlock Text="The five boxing wizards jump quickly."
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{Binding ForegroundBrush}"/>
            </Border>
        </Grid>

        <!-- Section separator -->
        <Border Height="1" Background="#20808080" Margin="0,0,0,8"/>

        <!-- Graphical Objects and UI Components: AA requires 3.0:1, no AAA requirement -->
        <Grid ColumnDefinitions="130,8,*" MinHeight="80">
            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                <StackPanel Spacing="1">
                    <TextBlock Text="Graphical Objects" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="and UI Components" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,8,Auto">
                    <TextBlock Grid.Column="0" Text="WCAG AA:" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding GraphicalAAResult}" FontSize="11" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="4" Padding="8" Background="{Binding BackgroundBrush}">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="&#9733;"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               Foreground="{Binding ForegroundBrush}"/>
                    <Border CornerRadius="3"
                            BorderThickness="1.5"
                            BorderBrush="{Binding ForegroundBrush}"
                            Padding="6,4">
                        <TextBlock Text="Text Input"
                                   FontSize="12"
                                   Foreground="{Binding ForegroundBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

    </StackPanel>

</Window>