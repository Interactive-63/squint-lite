<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SquintLite.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="360"
        d:DesignHeight="480"
        x:Class="SquintLite.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SquintLite"
        Width="360"
        Height="480"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Margin="12">

        <!-- Colour swatches -->
        <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Foreground" FontSize="11" Opacity="0.65"/>
                <Border Height="44" CornerRadius="4" Background="{Binding ForegroundBrush}"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Background" FontSize="11" Opacity="0.65"/>
                <Border Height="44" CornerRadius="4" Background="{Binding BackgroundBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Hex inputs -->
        <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,10">
            <TextBox Grid.Column="0"
                     Text="{Binding ForegroundHex}"
                     FontSize="12"
                     HorizontalContentAlignment="Center"
                     MaxLength="9"/>
            <TextBox Grid.Column="2"
                     Text="{Binding BackgroundHex}"
                     FontSize="12"
                     HorizontalContentAlignment="Center"
                     MaxLength="9"/>
        </Grid>

        <!-- Contrast ratio display: border colour and ratio value bound in Phase 3 -->
        <Border CornerRadius="4"
                Padding="20,10"
                HorizontalAlignment="Center"
                Margin="0,0,0,10"
                BorderThickness="2"
                BorderBrush="#30808080">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
                <TextBlock Text="Contrast Ratio"
                           FontSize="11"
                           Opacity="0.65"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="-"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Section separator -->
        <Border Height="1" Background="#20808080" Margin="0,0,0,8"/>

        <!-- Normal Text: AA requires 4.5:1, AAA requires 7:1 -->
        <Grid ColumnDefinitions="130,8,*" MinHeight="58" Margin="0,0,0,8">

            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="Normal Text" FontWeight="SemiBold" FontSize="12"/>
                <Grid ColumnDefinitions="Auto,8,Auto" RowDefinitions="Auto,5,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="WCAG AA:" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="-" FontSize="11" Opacity="0.45" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="WCAG AAA:" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="-" FontSize="11" Opacity="0.45" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <Border Grid.Column="2"
                    CornerRadius="4"
                    Padding="8"
                    Background="{Binding BackgroundBrush}">
                <TextBlock Text="The five boxing wizards jump quickly."
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{Binding ForegroundBrush}"/>
            </Border>

        </Grid>

        <!-- Section separator -->
        <Border Height="1" Background="#20808080" Margin="0,0,0,8"/>

        <!-- Large Text: AA requires 3:1, AAA requires 4.5:1 -->
        <!-- WCAG large text: 18pt (24px) regular or 14pt (18.67px) bold -->
        <Grid ColumnDefinitions="130,8,*" MinHeight="58" Margin="0,0,0,8">

            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="Large Text" FontWeight="SemiBold" FontSize="12"/>
                <Grid ColumnDefinitions="Auto,8,Auto" RowDefinitions="Auto,5,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="WCAG AA:" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="-" FontSize="11" Opacity="0.45" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="WCAG AAA:" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="2" Grid.Column="2"
                               Text="-" FontSize="11" Opacity="0.45" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <Border Grid.Column="2"
                    CornerRadius="4"
                    Padding="8"
                    Background="{Binding BackgroundBrush}">
                <TextBlock Text="The five boxing wizards jump quickly."
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{Binding ForegroundBrush}"/>
            </Border>

        </Grid>

        <!-- Section separator -->
        <Border Height="1" Background="#20808080" Margin="0,0,0,8"/>

        <!-- Graphical Objects and UI Components: AA requires 3:1, no AAA -->
        <Grid ColumnDefinitions="130,8,*" MinHeight="80">

            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                <StackPanel Spacing="1">
                    <TextBlock Text="Graphical Objects" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="and UI Components" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,8,Auto">
                    <TextBlock Grid.Column="0"
                               Text="WCAG AA:" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2"
                               Text="-" FontSize="11" Opacity="0.45" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Star represents a graphical object; bordered box represents a UI component -->
            <Border Grid.Column="2"
                    CornerRadius="4"
                    Padding="8"
                    Background="{Binding BackgroundBrush}">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="★"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               Foreground="{Binding ForegroundBrush}"/>
                    <Border CornerRadius="3"
                            BorderThickness="1.5"
                            BorderBrush="{Binding ForegroundBrush}"
                            Padding="6,4">
                        <TextBlock Text="Text Input"
                                   FontSize="12"
                                   Foreground="{Binding ForegroundBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

        </Grid>

    </StackPanel>

</Window>