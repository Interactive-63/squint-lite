<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SquintLite.ViewModels"
        xmlns:s="using:SquintLite.Services"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ic="using:FluentIcons.Avalonia"
        mc:Ignorable="d"
        d:DesignWidth="360"
        d:DesignHeight="510"
        x:Class="SquintLite.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/favicon.ico"
        Title="SquintLite"
        Width="360"
        Height="510"
        CanResize="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <StackPanel Margin="12">

        <!-- Colour swatches: clicking opens the picker flyout for each channel -->
        <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,8">

            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Foreground" FontSize="11" HorizontalAlignment="Center"/>
                <Button HorizontalAlignment="Stretch" Padding="0" Classes="swatch-btn">
                    <Button.Flyout>
                        <Flyout Placement="LeftEdgeAlignedTop">
                            <Flyout.FlyoutPresenterTheme>
                                <ControlTheme TargetType="FlyoutPresenter">
                                    <Setter Property="Background" Value="#152131"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="CornerRadius" Value="12"/>
                                    <Setter Property="BorderBrush" Value="#4A7FA8"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </ControlTheme>
                            </Flyout.FlyoutPresenterTheme>
                            <StackPanel Spacing="0">
                                <StackPanel.Resources>
                                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#7AADCC"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#1C3448"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2A4A62"/>
                                </StackPanel.Resources>
                                <ColorView Color="{Binding ForegroundColor, Mode=TwoWay}"
                                           IsColorPaletteVisible="False"
                                           IsColorPreviewVisible="False"
                                           IsAccentColorsVisible="False"
                                           Margin="10,10,10,0"
                                           CornerRadius="4"
                                           ColorSpectrumShape="Ring"/>
                                <Border Height="1" Background="#2A3F54" Margin="0,10,0,0"/>
                                <Button Classes="eyedropper-btn"
                                        Command="{Binding RequestForegroundEyedropperCommand}"
                                        IsVisible="{x:Static s:EyedropperService.IsSupported}"
                                        Margin="10,10,10,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="Pick from screen" VerticalAlignment="Center"/>
                                        <ic:FluentIcon Icon="Eyedropper" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <!-- Layered swatch: background fill beneath alpha-aware foreground -->
                    <Panel Height="44">
                        <Border CornerRadius="4" Background="{Binding BackgroundBrush}"/>
                        <Border CornerRadius="4" Background="{Binding ForegroundBrush}"/>
                        <Border CornerRadius="4"
                                BorderThickness="1.5"
                                BorderBrush="#50808080"
                                IsHitTestVisible="False"/>
                    </Panel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Background" FontSize="11" HorizontalAlignment="Center"/>
                <Button HorizontalAlignment="Stretch" Padding="0" Classes="swatch-btn">
                    <Button.Flyout>
                        <Flyout Placement="RightEdgeAlignedTop">
                            <Flyout.FlyoutPresenterTheme>
                                <ControlTheme TargetType="FlyoutPresenter">
                                    <Setter Property="Background" Value="#152131"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="CornerRadius" Value="12"/>
                                    <Setter Property="BorderBrush" Value="#4A7FA8"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </ControlTheme>
                            </Flyout.FlyoutPresenterTheme>
                            <StackPanel Spacing="0">
                                <StackPanel.Resources>
                                    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#7AADCC"/>
                                    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#1C3448"/>
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#2A4A62"/>
                                </StackPanel.Resources>
                                <ColorView Color="{Binding BackgroundColor, Mode=TwoWay}"
                                           IsColorPaletteVisible="False"
                                           IsColorPreviewVisible="False"
                                           IsAccentColorsVisible="False"
                                           IsAlphaVisible="False"
                                           Margin="10,10,10,0"
                                           CornerRadius="4"
                                           ColorSpectrumShape="Ring"/>
                                <Border Height="1" Background="#2A3F54" Margin="0,10,0,0"/>
                                <Button Classes="eyedropper-btn"
                                        Command="{Binding RequestBackgroundEyedropperCommand}"
                                        IsVisible="{x:Static s:EyedropperService.IsSupported}"
                                        Margin="10,10,10,10">
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                        <TextBlock Text="Pick from screen" VerticalAlignment="Center"/>
                                        <ic:FluentIcon Icon="Eyedropper" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <Border Height="44"
                            CornerRadius="4"
                            Background="{Binding BackgroundBrush}"
                            BorderBrush="#50808080"
                            BorderThickness="1.5"/>                
                </Button>
            </StackPanel>

        </Grid>

        <!-- Hex inputs -->
        <Grid ColumnDefinitions="*,8,*" Margin="0,0,0,10">
            <TextBox x:Name="ForegroundHexInput" 
                    Grid.Column="0"
                    Text="{Binding ForegroundHex}"
                    FontSize="12"
                    HorizontalContentAlignment="Center"
                    MaxLength="7"/>
            <TextBox x:Name="BackgroundHexInput"
                    Grid.Column="2"
                    Text="{Binding BackgroundHex}"
                    FontSize="12"
                    HorizontalContentAlignment="Center"
                    MaxLength="7"/>
        </Grid>

        <!-- Contrast ratio display -->
        <Border Classes="ratio-display"
                CornerRadius="4"
                Padding="20,10"
                HorizontalAlignment="Center"
                Margin="0,0,0,10"
                BorderThickness="2"
                BorderBrush="{Binding RatioDisplayBrush}">
            <StackPanel HorizontalAlignment="Center" Spacing="2">
                <TextBlock Text="Contrast Ratio"
                           FontSize="11"
                           Opacity="0.65"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding ContrastRatioDisplay}"
                           FontSize="28"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Section separator -->
        <Border Height="2" Background="#901C2B3A" Margin="0,0,0,8"/>

        <!-- Normal Text: AA requires 4.5:1, AAA requires 7.0:1 -->
        <Grid ColumnDefinitions="130,8,*" MinHeight="58" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="Normal Text" FontWeight="SemiBold" FontSize="12"/>
                <Grid ColumnDefinitions="Auto,8,Auto" RowDefinitions="Auto,5,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="WCAG AA:" FontSize="11" VerticalAlignment="Center"/>
                    <Border Grid.Row="0" Grid.Column="2"
                            Classes="result-badge"
                            Background="{Binding NormalTextAABadge}"
                            CornerRadius="3"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding NormalTextAAResult}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WCAG AAA:" FontSize="11" VerticalAlignment="Center"/>
                    <Border Grid.Row="2" Grid.Column="2"
                            Classes="result-badge"
                            Background="{Binding NormalTextAAABadge}"
                            CornerRadius="3"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding NormalTextAAAResult}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                </Grid>
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="4" Padding="8" Background="{Binding BackgroundBrush}">
                <TextBlock Text="The five boxing wizards jump quickly."
                           FontSize="14"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{Binding ForegroundBrush}"/>
            </Border>
        </Grid>

        <!-- Section separator -->
        <Border Height="2" Background="#901C2B3A" Margin="0,0,0,8"/>

        <!-- Large Text: AA requires 3.0:1, AAA requires 4.5:1 -->
        <!-- 24px = 18pt at 96 DPI, satisfying the WCAG large text threshold at any weight -->
        <Grid ColumnDefinitions="130,8,*" MinHeight="58" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="Large Text" FontWeight="SemiBold" FontSize="12"/>
                <Grid ColumnDefinitions="70,8,Auto" RowDefinitions="Auto,5,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="WCAG AA:" FontSize="11" VerticalAlignment="Center"/>
                    <Border Grid.Row="0" Grid.Column="2"
                            Classes="result-badge"
                            Background="{Binding LargeTextAABadge}"
                            CornerRadius="3"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding LargeTextAAResult}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="WCAG AAA:" FontSize="11" VerticalAlignment="Center"/>
                    <Border Grid.Row="2" Grid.Column="2"
                            Classes="result-badge"
                            Background="{Binding LargeTextAAABadge}"
                            CornerRadius="3"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding LargeTextAAAResult}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>                
                </Grid>
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="4" Padding="8" Background="{Binding BackgroundBrush}">
                <TextBlock Text="The five boxing wizards jump quickly."
                           FontSize="24"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Foreground="{Binding ForegroundBrush}"/>
            </Border>
        </Grid>

        <!-- Section separator -->
        <Border Height="2" Background="#901C2B3A" Margin="0,0,0,8"/>

        <!-- Graphical Objects and UI Components: AA requires 3.0:1, no AAA requirement -->
        <Grid ColumnDefinitions="130,8,*" MinHeight="80">
            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                <StackPanel Spacing="1">
                    <TextBlock Text="Graphical Objects" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock Text="and UI Components" FontWeight="SemiBold" FontSize="12"/>
                </StackPanel>
                <Grid ColumnDefinitions="Auto,8,Auto">
                    <TextBlock Grid.Column="0" Text="WCAG AA:" FontSize="11" VerticalAlignment="Center"/>
                    <Border Grid.Column="2"
                            Classes="result-badge"
                            Background="{Binding GraphicalAABadge}"
                            CornerRadius="3"
                            Padding="7,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding GraphicalAAResult}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                    </Border>                
                </Grid>
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="4" Padding="8" Background="{Binding BackgroundBrush}">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="&#9733;"
                               FontSize="22"
                               HorizontalAlignment="Center"
                               Foreground="{Binding ForegroundBrush}"/>
                    <Border CornerRadius="3"
                            BorderThickness="1.5"
                            BorderBrush="{Binding ForegroundBrush}"
                            Padding="6,4">
                        <TextBlock Text="Text Input"
                                   FontSize="12"
                                   Foreground="{Binding ForegroundBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

    </StackPanel>

</Window>