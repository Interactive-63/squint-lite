<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SquintLite.Views.EyedropperScreenWindow"
        WindowDecorations="None"
        WindowState="FullScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        Background="Black">

    <Panel>

        <!-- Captured screenshot fills the window -->
        <Image x:Name="ScreenImage"
               Stretch="Fill"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <!-- Colour preview label that follows the cursor -->
        <Border x:Name="CursorPreview"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#E0111111"
                CornerRadius="6"
                Padding="8,7"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border x:Name="PreviewSwatch"
                        Width="30"
                        Height="30"
                        CornerRadius="4"
                        BorderBrush="#50FFFFFF"
                        BorderThickness="1"/>
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock x:Name="PreviewHex"
                               Text="#000000"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock Text="Click to pick   Esc to cancel"
                               FontSize="10"
                               Foreground="#80FFFFFF"/>
                </StackPanel>
            </StackPanel>
        </Border>

    </Panel>

</Window>