<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SquintLite.Views.EyedropperOverlayWindow"
        WindowDecorations="None"
        Width="160"
        Height="52"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        CanResize="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

    <Border Background="#E0111111"
            CornerRadius="6"
            Padding="8,7">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

            <Border x:Name="ColorSwatch"
                    Width="30"
                    Height="30"
                    CornerRadius="4"
                    BorderBrush="#50FFFFFF"
                    BorderThickness="1"/>

            <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock x:Name="HexLabel"
                           Text="#000000"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="White"/>
                <TextBlock Text="Click to pick"
                           FontSize="10"
                           Foreground="#80FFFFFF"/>
            </StackPanel>

        </StackPanel>
    </Border>

</Window>