<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SquintLite.App"
             xmlns:local="using:SquintLite"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />

        <!-- ColourView Tab Styling -->
        <Style Selector="ColorView TabControl">
            <Setter Property="Background" Value="#2A3F54"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="ColorView TabItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#60FFFFFF"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="ColorView TabItem:pointerover">
            <Setter Property="Background" Value="#1A3347"/>
            <Setter Property="Foreground" Value="#BBFFFFFF"/>
        </Style>

        <Style Selector="ColorView TabItem:selected">
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="ColorView TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="#4A7FA8"/>
        </Style>

        <!-- ColorView Component Tab Radiobutton -->
        <Style Selector="ColorView /template/ RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#60FFFFFF"/>
            <Setter Property="CornerRadius" Value="4" />
        </Style>

        <Style Selector="ColorView /template/ RadioButton:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style Selector="ColorView /template/ RadioButton:unchecked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A3347"/>
            <Setter Property="Foreground" Value="#BBFFFFFF"/>
        </Style>

        <Style Selector="ColorView /template/ RadioButton:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- ColorView Component Tab Hex Textbox: Working -->
        <Style Selector="ColorView /template/ TextBox">
            <Setter Property="Background" Value="#1A2D3D"/>
            <Setter Property="BorderBrush" Value="#2A4A62"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style Selector="ColorView /template/ TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1A3347"/>
            <Setter Property="BorderBrush" Value="#4A7FA8"/>
        </Style>

        <Style Selector="ColorView /template/ TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1A3347"/>
            <Setter Property="BorderBrush" Value="#2A4A62"/>
        </Style>

        <!-- ColorView Component Tab NumericUpDown R,G,B,A entry fields: Working-->
        <Style Selector="ColorView /template/ NumericUpDown">
            <Setter Property="Background" Value="#1A2D3D"/>
            <Setter Property="BorderBrush" Value="#2A4A62"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>

        <Style Selector="ColorView /template/ NumericUpDown /template/ TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1A3347"/>
            <Setter Property="BorderBrush" Value="#4A7FA8"/>
        </Style>

        <Style Selector="ColorView /template/ NumericUpDown /template/ TextBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#1A3347"/>
            <Setter Property="BorderBrush" Value="#2A4A62"/>
        </Style>


        <!-- Swatch button: scale on hover and press -->
        <Style Selector="Button.swatch-btn">
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <TransformOperationsTransition Property="RenderTransform"
                                                       Duration="0:0:0.18"
                                                       Easing="CubicEaseOut"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.swatch-btn:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.05)"/>
        </Style>
        <Style Selector="Button.swatch-btn:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)"/>
        </Style>

        <!-- Badge border: smooth background colour transition on ratio change -->
        <Style Selector="Border.result-badge">
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background"
                                         Duration="0:0:0.50"
                                         Easing="CubicEaseInOut"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ratio display: smooth border colour transition -->
        <Style Selector="Border.ratio-display">
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="BorderBrush"
                                         Duration="0:0:0.5"
                                         Easing="CubicEaseInOut"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Eyedropper button: -->
        <Style Selector="Button.eyedropper-btn">
            <Setter Property="Background" Value="#2A3F54"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Transitions">
                <Setter.Value>
                    <Transitions>
                        <BrushTransition Property="Background" Duration="0:0:0.12"/>
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" Easing="CubicEaseOut"/>
                    </Transitions>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.eyedropper-btn:pointerover">
            <Setter Property="Background" Value="#3D5F7A"/>
            <Setter Property="RenderTransform" Value="scale(1.02)"/>
        </Style>
        <Style Selector="Button.eyedropper-btn:pressed">
            <Setter Property="Background" Value="#162130"/>
            <Setter Property="RenderTransform" Value="scale(0.98)"/>
        </Style>


    </Application.Styles>
</Application>